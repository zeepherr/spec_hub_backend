// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  ARCHIVED
}

enum ConditionGrade {
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum AnswerType {
  BOOLEAN
  NUMBER
  TEXT
  SELECT
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  SELLER_SHIPPING
  INSPECTION_PENDING
  INSPECTING
  VERIFIED
  REJECTED
  SHIPPING_TO_BUYER
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  RELEASED
}

enum ShipmentType {
  SELLER_TO_ADMIN
  ADMIN_TO_BUYER
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum InspectionStatus {
  PENDING
  PASSED
  FAILED
  NEEDS_REVIEW
}

enum ChatRole {
  BUYER
  SELLER
  ADMIN
}

enum SupportIssueType {
  PRODUCT_NOT_AS_DESCRIBED
  PAYMENT
  SHIPPING
  DAMAGED_PRODUCT
  SELLER_NOT_RESPONDING
  BUYER_NOT_RESPONDING
  OTHER
}

enum SupportStatus {
  OPEN
  INVESTIGATING
  WAITING_FOR_BUYER
  WAITING_FOR_SELLER
  RESOLVED
  CLOSED
}

model User {
  id                   String                    @id @default(uuid())
  role                 UserRole                  @default(USER)
  email                String                    @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  profileImageUrl      String?
  isVerified           Boolean                   @default(false)
  isActive             Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  listings             Listing[]
  authSessions         AuthSession[]
  buyerOrders          Order[]                   @relation("BuyerOrders")
  sellerOrders         Order[]                   @relation("SellerOrders")
  createdConversations Conversation[]            @relation("ConversationCreator")
  participants         ConversationParticipant[]
  messages             Message[]
  payments             Payment[]
  inspections          Inspection[]              @relation("InspectionAdmin")
  reviewsWritten       Review[]                  @relation("ReviewWriter")
  reviewsReceived      Review[]                  @relation("ReviewReceiver")
  openedSupportCases   SupportCase[]             @relation("SupportCaseOpenedBy")
  assignedCases        SupportCase[]             @relation("SupportCaseAdmin")
}

model AuthSession {
  id           Int       @id @default(autoincrement())
  userId       String
  refreshToken String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PendingRegistration {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  otpHash      String
  attempts     Int      @default(0)
  lastSentAt   DateTime
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model Category {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  listings           Listing[]
  conditionQuestions ConditionQuestion[]
}

model Listing {
  id                 String                  @id @default(uuid())
  sellerId           String
  categoryId         Int
  title              String
  description        String
  brand              String
  model              String
  price              Decimal                 @db.Decimal(12, 2)
  estimatedCondition ConditionGrade?
  estimatedScore     Decimal?                @db.Decimal(5, 2)
  location           String
  status             ListingStatus           @default(DRAFT)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  seller             User                    @relation(fields: [sellerId], references: [id])
  category           Category                @relation(fields: [categoryId], references: [id])
  images             ListingImage[]
  conditionAnswers   SellerConditionAnswer[]
  conversations      Conversation[]
  orders             Order[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

model ListingImage {
  id        Int      @id @default(autoincrement())
  listingId String
  imageUrl  String
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model ConditionQuestion {
  id         Int        @id @default(autoincrement())
  categoryId Int
  label      String
  answerType AnswerType
  options    Json?
  isRequired Boolean    @default(true)
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  answers SellerConditionAnswer[]

  @@index([categoryId])
}

model SellerConditionAnswer {
  id          Int      @id @default(autoincrement())
  listingId   String
  questionId  Int
  answerValue Json
  createdAt   DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  question ConditionQuestion @relation(fields: [questionId], references: [id])

  @@unique([listingId, questionId])
  @@index([listingId])
  @@index([questionId])
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  listingId    String?
  orderId      Int?
  createdById  String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  listing      Listing?                  @relation(fields: [listingId], references: [id])
  order        Order?                    @relation(fields: [orderId], references: [id])
  createdBy    User                      @relation("ConversationCreator", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
  supportCases SupportCase[]

  @@index([listingId])
  @@index([orderId])
  @@index([createdById])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         String
  roleInChat     ChatRole
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Order {
  id            Int            @id @default(autoincrement())
  orderNumber   String         @unique
  listingId     String
  buyerId       String
  sellerId      String
  status        OrderStatus    @default(PENDING)
  lockedAt      DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  listing       Listing        @relation(fields: [listingId], references: [id])
  buyer         User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller        User           @relation("SellerOrders", fields: [sellerId], references: [id])
  payment       Payment?
  shipments     Shipment[]
  inspection    Inspection?
  conversations Conversation[]
  reviews       Review[]
  supportCases  SupportCase[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id          Int           @id @default(autoincrement())
  orderId     Int           @unique
  buyerId     String
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  providerRef String?
  paidAt      DateTime?
  refundedAt  DateTime?
  releasedAt  DateTime?
  createdAt   DateTime      @default(now())
  order       Order         @relation(fields: [orderId], references: [id])
  buyer       User          @relation(fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([status])
}

model Shipment {
  id             Int            @id @default(autoincrement())
  orderId        Int
  shipmentType   ShipmentType
  carrier        String
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  order          Order          @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([trackingNumber])
}

model Inspection {
  id                Int              @id @default(autoincrement())
  orderId           Int              @unique
  adminId           String
  verifiedCondition ConditionGrade?
  verifiedScore     Decimal?         @db.Decimal(5, 2)
  result            InspectionStatus @default(PENDING)
  notes             String?
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  order             Order            @relation(fields: [orderId], references: [id])
  admin             User             @relation("InspectionAdmin", fields: [adminId], references: [id])
  items             InspectionItem[]

  @@index([adminId])
}

model InspectionItem {
  id           Int        @id @default(autoincrement())
  inspectionId Int
  itemLabel    String
  itemResult   String
  score        Decimal    @db.Decimal(5, 2)
  note         String?
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model SupportCase {
  id             Int              @id @default(autoincrement())
  orderId        Int
  conversationId Int
  openedById     String
  adminId        String?
  issueType      SupportIssueType
  status         SupportStatus    @default(OPEN)
  resolutionNote String?
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?
  order          Order            @relation(fields: [orderId], references: [id])
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  openedBy       User             @relation("SupportCaseOpenedBy", fields: [openedById], references: [id])
  admin          User?            @relation("SupportCaseAdmin", fields: [adminId], references: [id])

  @@index([orderId])
  @@index([conversationId])
  @@index([openedById])
  @@index([adminId])
  @@index([status])
}

model Review {
  id         Int      @id @default(autoincrement())
  orderId    Int
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
  reviewer   User     @relation("ReviewWriter", fields: [reviewerId], references: [id])
  reviewee   User     @relation("ReviewReceiver", fields: [revieweeId], references: [id])

  @@unique([orderId, reviewerId, revieweeId])
  @@index([reviewerId])
  @@index([revieweeId])
}
